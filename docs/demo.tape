# Records docs/demo.gif with vhs (https://github.com/charmbracelet/vhs):
#   go build -o /tmp/a2ui-tea ./cmd/a2ui-tea && PATH=/tmp:$PATH vhs docs/demo.tape
Output docs/demo.gif

Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 420
Set Padding 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms

Type "a2ui-tea demo" Enter
Sleep 1200ms
Type "Ada"
Sleep 400ms
Tab
Sleep 300ms
Enter
Sleep 5500ms
Tab
Sleep 600ms
Right
Sleep 1200ms
Right
Sleep 800ms
Tab
Right
Sleep 250ms
Right
Sleep 500ms
Tab
Space
Sleep 500ms
Tab
Right
Sleep 250ms
Space
Sleep 900ms
Tab
Enter
Sleep 1500ms
Enter
Sleep 2800ms
Type "q"
Sleep 500ms
